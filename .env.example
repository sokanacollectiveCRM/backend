SUPABASE_URL= #your supabase url here
SUPABASE_ANON_KEY= # your supabase anon key here

# Private GCS documents bucket (contract templates live under contract-templates/)
GCS_DOCUMENTS_BUCKET=sokana-private-documents
# Existing private object prefixes (defaults shown)
GCS_CONTRACTS_PREFIX=contracts
GCS_CONTRACT_TEMPLATES_PREFIX=contract-templates

# Native contracts (keep disabled until migration, template seed, and smoke pass)
NATIVE_CONTRACTS_ENABLED=false
CONTRACT_SIGNING_BASE_URL=http://localhost:3001/signing
CONTRACT_INVITATION_TTL_HOURS=72
CONTRACT_PDF_URL_TTL_SECONDS=300

# Set through Secret Manager outside local development; never commit a real value.
SIGNING_RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
SIGNING_RATE_LIMIT_ATTEMPTS=30
SIGNING_RATE_LIMIT_WINDOW_SECONDS=60

# Native contract input limits
CONTRACT_DRAWN_SIGNATURE_MAX_BYTES=262144

# Native contract transactional outbox worker
CONTRACT_OUTBOX_POLL_MS=5000
CONTRACT_OUTBOX_ENABLED=false
CONTRACT_OUTBOX_LEASE_SECONDS=60
CONTRACT_OUTBOX_BATCH_SIZE=10
CONTRACT_OUTBOX_MAX_ATTEMPTS=10
# Private BCC recipient for every completed signed-contract PDF.
CONTRACT_SIGNED_COPY_INTERNAL_EMAIL=hello@sokanacollective.com
# Admin notification recipient when a client completes signing.
# CONTRACT_SIGNED_ADMIN_NOTIFICATION_EMAIL=hello@sokanacollective.com

PORT=5050 # this is the default that we used when making the template
NODE_ENV=development # NOTE: change to `production` when deploying to Cloud Run

# CORS: required in production so frontend can call API (comma-separated for multiple)
FRONTEND_ORIGIN=http://localhost:3001
# Legacy (also used for CORS if FRONTEND_ORIGIN not set):
FRONTEND_URL=http://localhost:3001
FRONTEND_URL_DEV=http://localhost:3001
API_URL=http://localhost:5050

# Provider webhooks (PR 5) — required in production
SIGNNOW_WEBHOOK_SECRET= # HMAC secret_key for SignNow event subscription (X-SignNow-Signature)
QB_WEBHOOK_VERIFIER_TOKEN= # Intuit app verifier token (intuit-signature)
# INTUIT_WEBHOOK_VERIFIER_TOKEN= # alias for QB_WEBHOOK_VERIFIER_TOKEN
# QUICKBOOKS_ENVIRONMENT=production # or sandbox for a separate token row
# Local laptops share Cloud SQL with prod — leave unset/false so local never refresh/save/delete QB tokens.
# Cloud Run sets K_SERVICE and is allowed by default. Only set true for an intentional local sandbox.
# QUICKBOOKS_ALLOW_TOKEN_WRITES=false

# Intake feature package (PR 8) — default keeps legacy write path behind façade
# INTAKE_USE_FEATURE_PACKAGE=false
# INTAKE_SHADOW_COMPARE=false

# Public intake abuse protection (P0)
# INTAKE_ABUSE_STORE=memory # or db (default: memory in test, db otherwise)
# INTAKE_ABUSE_ENFORCE=true # force rate limits/soft-dedupe in test; default on outside test
# INTAKE_RATE_LIMIT_IP_MAX=10
# INTAKE_RATE_LIMIT_EMAIL_MAX=3
# INTAKE_RATE_LIMIT_WINDOW_MS=3600000
# INTAKE_IDEMPOTENCY_TTL_MS=86400000
# INTAKE_SOFT_DEDUPE_WINDOW_MS=300000
